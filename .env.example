# ── Stripe ─────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── JWT ─────────────────────────────────────────────────────────────
# A random 64-character secret — generate one at https://generate-secret.vercel.app/64
JWT_SECRET=your_random_64_character_secret_here

# ── Resend (email) ──────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_...

# The email address to send FROM (must be a verified domain in Resend)
FROM_EMAIL=Alderney Week <noreply@alderneyweek.com>

# ── Site URL ────────────────────────────────────────────────────────
# Your live Netlify URL (no trailing slash)
SITE_URL=https://alderneyweek.com
